<Window x:Class="SimOS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimOS.UI"
        xmlns:converters="clr-namespace:SimOS.UI.Converters"
        Title="SimOS"
        Height="700"
        Width="1100">
    <Window.Resources>
        <converters:EventTypeToBrushConverter x:Key="EventTypeToBrush"/>
    </Window.Resources>

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="SimOS"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Main area -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CPU -->
            <GroupBox Grid.Column="0"
                      Header="CPU"
                      Margin="0,0,10,0">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Mode:"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="USER"
                               FontWeight="Bold"
                               x:Name="CpuModeText"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Current PID:"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="---"
                               x:Name="CurrentPidText"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Program Counter:"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="0"
                               x:Name="ProgramCounterText"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Instruction:"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="0"
                               x:Name="InstructionText"/>

                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Text="Registers"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="R0:"/>

                    <TextBlock Grid.Row="6"
                               Grid.Column="1"
                               Text="0"
                               x:Name="RegisterR0Text"/>

                    <TextBlock Grid.Row="7"
                               Grid.Column="0"
                               Text="R1:"/>

                    <TextBlock Grid.Row="7"
                               Grid.Column="1"
                               Text="0"
                               x:Name="RegisterR1Text"/>

                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               Text="R2:"/>

                    <TextBlock Grid.Row="8"
                               Grid.Column="1"
                               Text="0"
                               x:Name="RegisterR2Text"/>

                    <TextBlock Grid.Row="9"
                               Grid.Column="0"
                               Text="R3:"/>

                    <TextBlock Grid.Row="9"
                               Grid.Column="1"
                               Text="0"
                               x:Name="RegisterR3Text"/>

                    <TextBlock Grid.Row="10"
                               Grid.Column="0"
                               Text="R4:"/>

                    <TextBlock Grid.Row="10"
                               Grid.Column="1"
                               Text="0"
                               x:Name="RegisterR4Text"/>

                    <TextBlock Grid.Row="11"
                               Grid.Column="0"
                               Text="R5:"/>

                    <TextBlock Grid.Row="11"
                               Grid.Column="1"
                               Text="0"
                               x:Name="RegisterR5Text"/>

                    <TextBlock Grid.Row="12"
                               Grid.Column="0"
                               Text="R6:"/>

                    <TextBlock Grid.Row="12"
                               Grid.Column="1"
                               Text="0"
                               x:Name="RegisterR6Text"/>

                    <TextBlock Grid.Row="13"
                               Grid.Column="0"
                               Text="R7:"/>

                    <TextBlock Grid.Row="13"
                               Grid.Column="1"
                               Text="0"
                               x:Name="RegisterR7Text"/>
                </Grid>
            </GroupBox>


            <!-- Processes -->
            <GroupBox Grid.Column="1"
                      Header="Processes">

                <DataGrid x:Name="ProcessGrid"
                          Margin="10"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="PID"
                                            Binding="{Binding PID}"
                                            Width="80"/>

                        <DataGridTemplateColumn Header="State"
                                                Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProcessState}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding ProcessState, Converter={StaticResource ProcessStateToBrushConverter}}"
                                                   FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="PC"
                                            Binding="{Binding CpuState.ProgramCounter}"
                                            Width="100"/>
                    </DataGrid.Columns>

                </DataGrid>

            </GroupBox>

        </Grid>


        <!-- Bottom information -->
        <Grid Grid.Row="2"
              Margin="0,15,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- Scheduler -->
            <GroupBox Grid.Column="0"
                      Header="Scheduler"
                      Margin="0,0,10,0">

                <StackPanel Margin="10">

                    <TextBlock Text="Ready Queue"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>

                    <ListBox x:Name="ReadyQueueList"
                             Height="200"
                             ScrollViewer.VerticalScrollBarVisibility="Visible">
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Margin="0,2"
                                        Padding="8,4"
                                        CornerRadius="4">

                                    <StackPanel Orientation="Horizontal">


                                            <TextBlock Text="{Binding PID, StringFormat=PID {0}}"
                                                        FontWeight="Bold"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Text="{Binding ProcessState}"
                                                       Margin="20,0,0,0"
                                                        FontSize="12"
                                                        Opacity="0.7"
                                                       VerticalAlignment="Center"/>


                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Priority}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </StackPanel>

            </GroupBox>


            <!-- Events -->
            <GroupBox Grid.Column="1"
                      Header="Events">

                <ListBox x:Name="EventLog"
                         Margin="10">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Height" Value="35"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{Binding EventType, Converter={StaticResource EventTypeToBrush}}"
                                       FontFamily="Consolas"
                                       Margin="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </GroupBox>

        </Grid>


        <!-- Controls -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Step"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Click="Step_Click"/>

            <Button Content="Run"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Click="Run_Click"/>

        </StackPanel>

    </Grid>

</Window>